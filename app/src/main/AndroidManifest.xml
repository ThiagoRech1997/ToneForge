<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== PERMISSÕES ESSENCIAIS PARA FUNCIONALIDADE DE ÁUDIO ===== -->
    
    <!-- NECESSÁRIA: Captura de áudio do microfone para gravação e afinador -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- NECESSÁRIA: Ajuste de configurações de áudio do dispositivo -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- NECESSÁRIA: Execução do serviço de áudio em primeiro plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- NECESSÁRIA: Reprodução de mídia em serviço em primeiro plano (Android 12+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    
    <!-- NECESSÁRIA: Envio de notificações ao usuário (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- NECESSÁRIA: Mantém a CPU ativa para reprodução contínua de áudio -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- NECESSÁRIA: Feedback tátil em interações do usuário -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ===== PERMISSÕES DE ARMAZENAMENTO (RESTRITAS POR VERSÃO) ===== -->
    
    <!-- DEPRECIADA: Salva arquivos em dispositivos com Android até a versão 9 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    
    <!-- DEPRECIADA: Lê arquivos externos em dispositivos com Android até a versão 12 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- NECESSÁRIA: Lê arquivos de áudio para importar presets e loops (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- ===== PERMISSÕES REMOVIDAS POR SEGURANÇA ===== -->
    <!-- REMOVIDA: ACCESS_NETWORK_STATE - Não é necessária para funcionalidade local -->
    <!-- REMOVIDA: ACCESS_WIFI_STATE - Não é necessária para funcionalidade local -->
    <!-- REMOVIDA: CHANGE_WIFI_STATE - Não é necessária para funcionalidade local -->
    <!-- REMOVIDA: INTERNET - Não é necessária para funcionalidade local -->
    <!-- REMOVIDA: READ_MEDIA_IMAGES - Não é necessária para funcionalidade de áudio -->
    <!-- REMOVIDA: READ_MEDIA_VIDEO - Não é necessária para funcionalidade de áudio -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToneForge">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PedalDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ToneForge"
            android:label="" />

        <!-- Fase 0 — activity de debug para benchmark do pipeline Oboe.
             Lançar via: adb shell am start -n com.thiagofernendorech.toneforge/com.thiagofernendorech.toneforge.ui.debug.DebugBenchmarkActivity -->
        <activity
            android:name="com.thiagofernendorech.toneforge.ui.debug.DebugBenchmarkActivity"
            android:exported="true"
            android:theme="@style/Theme.ToneForge"
            android:label="Oboe Benchmark" />

        <!-- Serviço de áudio em background com permissões mínimas -->
        <service
            android:name=".AudioBackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"
            android:description="@string/audio_background_service_description" />
            
        <!-- FileProvider restrito para compartilhamento seguro de arquivos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.thiagofernendorech.toneforge.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>