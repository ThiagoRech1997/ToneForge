<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 
        CONFIGURAÇÃO DE SEGURANÇA DO FILEPROVIDER
        ========================================
        
        RESTRIÇÕES IMPLEMENTADAS:
        - Apenas diretórios específicos de loops são expostos
        - Caminhos são limitados a subdiretórios específicos
        - Não há acesso a diretórios raiz ou outros arquivos do app
        - Cada caminho tem um nome específico para controle de acesso
        
        ARQUIVOS EXPOSTOS:
        - Apenas arquivos .wav de loops criados pelo app
        - Localizados em diretórios específicos e controlados
        - Sem acesso a arquivos de sistema ou outros apps
    -->
    
    <!-- Diretório interno de loops - apenas arquivos .wav do app -->
    <files-path name="internal_loops" path="loops/" />
    
    <!-- Diretório de cache de loops - apenas arquivos temporários do app -->
    <cache-path name="cache_loops" path="loops/" />
    
    <!-- Diretório externo de loops - apenas arquivos .wav do app -->
    <external-files-path name="external_loops" path="loops/" />
    
    <!-- 
        CAMINHOS REMOVIDOS POR SEGURANÇA:
        - external-path: Removido para evitar acesso a todo armazenamento externo
        - external-cache-path: Removido para evitar acesso a cache de outros apps
        - root-path: Removido para evitar acesso ao sistema de arquivos raiz
    -->
</paths>