<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_settings_hilava.xml
    Interface Settings inspirada no HILAVA OS do Lava ME 3
    Cards com cantos arredondados, visual limpo e hierarquia clara
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hilava_background">

    <!-- ===== SCROLL PRINCIPAL ===== -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ========================================== -->
            <!-- CARD: CONFIGURAÇÕES GERAIS -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/hilava_settings_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <!-- Título da seção -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geral"
                    android:textColor="@color/hilava_text_secondary"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp" />

                <!-- Tema Escuro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tema Escuro"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interface com fundo escuro"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchDarkTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/hilava_settings_section_divider"
                    android:layout_marginVertical="12dp" />

                <!-- Vibração -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vibração"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feedback tátil ao interagir"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchVibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/hilava_settings_section_divider"
                    android:layout_marginVertical="12dp" />

                <!-- Auto Save -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salvar Automaticamente"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salvar gravações ao finalizar"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAutoSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/hilava_settings_section_divider"
                    android:layout_marginVertical="12dp" />

                <!-- Áudio em Background -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Áudio em Background"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manter processamento ativo em segundo plano"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAudioBackground"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hilava_surface_elevated"
                    android:layout_marginVertical="16dp" />

                <!-- Pipeline C++ experimental (Fase 5 beta mitigação).
                     Expõe o toggle que antes só era alcançável via DebugBenchmarkActivity.
                     Ver app/DEPRECATED.md e docs/migration-status.md. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pipeline C++ (experimental)"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Usa o novo backend Oboe em C++ em vez do AudioRecord/AudioTrack. Pode ter latência menor em alguns devices. Pare o áudio antes de alternar."
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="12dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchCppPipeline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- CARD: LATÊNCIA -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/hilava_settings_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <!-- Título da seção -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latência"
                    android:textColor="@color/hilava_tuner"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp" />

                <!-- Info de latência atual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/hilava_settings_button_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/textLatencyInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo Atual: Equilibrado"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textLatencyDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latência Estimada: 21.3 ms"
                        android:textColor="@color/hilava_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Modo de Latência -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de Latência"
                    android:textColor="@color/hilava_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/radioGroupLatency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioLowLatency"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Baixa Latência"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_tuner"
                        android:paddingStart="8dp" />

                    <RadioButton
                        android:id="@+id/radioBalanced"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Equilibrado"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_tuner"
                        android:checked="true"
                        android:paddingStart="8dp" />

                    <RadioButton
                        android:id="@+id/radioStability"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Estabilidade"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_tuner"
                        android:paddingStart="8dp" />
                </RadioGroup>

                <!-- Botão Info -->
                <Button
                    android:id="@+id/buttonLatencyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Informações sobre Latência"
                    android:textColor="@color/hilava_text_secondary"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/hilava_settings_button_bg"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- ========================================== -->
            <!-- CARD: MIDI -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/hilava_settings_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <!-- Título da seção -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIDI"
                    android:textColor="@color/hilava_effects"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp" />

                <!-- MIDI Enable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo de Aprendizado"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mapear controles MIDI automaticamente"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchMidiEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- Status MIDI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/hilava_settings_button_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/textMidiStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MIDI Desabilitado"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textMidiDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhum dispositivo"
                        android:textColor="@color/hilava_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Botões MIDI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonMidiScan"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Escanear"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:background="@drawable/hilava_settings_button_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/buttonMidiMappings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Mapeamentos"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:background="@drawable/hilava_settings_button_bg"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- CARD: LOGS / DEPURAÇÃO -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/hilava_settings_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <!-- Título da seção -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depuração"
                    android:textColor="@color/hilava_warning"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp" />

                <!-- Verbose Logging -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logging Verboso"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registrar detalhes adicionais"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchVerboseLogging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/hilava_settings_section_divider"
                    android:layout_marginVertical="12dp" />

                <!-- Debug Logging -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logging de Debug"
                            android:textColor="@color/hilava_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Informações para desenvolvimento"
                            android:textColor="@color/hilava_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchDebugLogging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/hilava_settings_section_divider"
                    android:layout_marginVertical="12dp" />

                <!-- Nível de Log -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nível de Log"
                    android:textColor="@color/hilava_text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/radioGroupLogLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioLogError"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Apenas Erros"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_warning"
                        android:paddingStart="8dp" />

                    <RadioButton
                        android:id="@+id/radioLogWarn"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Avisos e Erros"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_warning"
                        android:paddingStart="8dp" />

                    <RadioButton
                        android:id="@+id/radioLogInfo"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Informações, Avisos e Erros"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_warning"
                        android:checked="true"
                        android:paddingStart="8dp" />

                    <RadioButton
                        android:id="@+id/radioLogDebug"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Debug Completo"
                        android:textColor="@color/hilava_text_primary"
                        android:textSize="14sp"
                        android:buttonTint="@color/hilava_warning"
                        android:paddingStart="8dp" />
                </RadioGroup>

            </LinearLayout>

            <!-- ========================================== -->
            <!-- BOTÃO SOBRE -->
            <!-- ========================================== -->
            <Button
                android:id="@+id/settingsAboutButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sobre o ToneForge"
                android:textColor="@color/hilava_text_primary"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/hilava_settings_about_button_bg"
                android:layout_marginTop="4dp" />

            <!-- Versão -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ToneForge v1.0"
                android:textColor="@color/hilava_text_hint"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
