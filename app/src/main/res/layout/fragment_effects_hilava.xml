<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hilava_background">

    <!-- Status Card do Pipeline -->
    <androidx.cardview.widget.CardView
        android:id="@+id/pipelineStatusCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/hilava_card_background"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <View
                android:id="@+id/pipelineIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/hilava_status_dot" />

            <TextView
                android:id="@+id/effectsStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Pipeline de Áudio"
                android:textColor="@color/hilava_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/activeEffectsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 efeitos ativos"
                android:textColor="@color/hilava_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Título da Seção -->
    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:text="Categorias de Efeitos"
        android:textColor="@color/hilava_text_secondary"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/pipelineStatusCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grid de Categorias -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/categoriesGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/sectionTitle"
        app:layout_constraintBottom_toTopOf="@id/chainCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Linha 1: Distortion e Modulation -->
        <com.thiagofernendorech.toneforge.ui.widgets.HilavaAppButton
            android:id="@+id/btnDistortion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:hilava_color="@color/effect_distortion"
            app:hilava_icon="@drawable/ic_distortion"
            app:hilava_label="Distortion"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnModulation"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <com.thiagofernendorech.toneforge.ui.widgets.HilavaAppButton
            android:id="@+id/btnModulation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:hilava_color="@color/effect_modulation"
            app:hilava_icon="@drawable/ic_modulation"
            app:hilava_label="Modulation"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnDistortion"
            app:layout_constraintEnd_toStartOf="@id/btnTime" />

        <com.thiagofernendorech.toneforge.ui.widgets.HilavaAppButton
            android:id="@+id/btnTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:hilava_color="@color/effect_time"
            app:hilava_icon="@drawable/ic_time"
            app:hilava_label="Time"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnModulation"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Linha 2: Filter, Dynamics, Ambient -->
        <com.thiagofernendorech.toneforge.ui.widgets.HilavaAppButton
            android:id="@+id/btnFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:hilava_color="@color/effect_filter"
            app:hilava_icon="@drawable/ic_filter"
            app:hilava_label="Filter"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toBottomOf="@id/btnDistortion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDynamics"
            android:layout_marginTop="8dp" />

        <com.thiagofernendorech.toneforge.ui.widgets.HilavaAppButton
            android:id="@+id/btnDynamics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:hilava_color="@color/effect_dynamics"
            app:hilava_icon="@drawable/ic_dynamics"
            app:hilava_label="Dynamics"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toBottomOf="@id/btnModulation"
            app:layout_constraintStart_toEndOf="@id/btnFilter"
            app:layout_constraintEnd_toStartOf="@id/btnAmbient"
            android:layout_marginTop="8dp" />

        <com.thiagofernendorech.toneforge.ui.widgets.HilavaAppButton
            android:id="@+id/btnAmbient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:hilava_color="@color/effect_ambient"
            app:hilava_icon="@drawable/ic_ambient"
            app:hilava_label="Ambient"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toBottomOf="@id/btnTime"
            app:layout_constraintStart_toEndOf="@id/btnDynamics"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card da Chain Ativa -->
    <androidx.cardview.widget.CardView
        android:id="@+id/chainCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/hilava_card_background"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chain de Efeitos"
                    android:textColor="@color/hilava_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEditChain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Editar"
                    android:textColor="@color/hilava_effects"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" />

            </LinearLayout>

            <!-- RecyclerView horizontal para chain de efeitos -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/effectsChainContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Efeitos serão adicionados programaticamente -->
                    <TextView
                        android:id="@+id/emptyChainText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhum efeito ativo"
                        android:textColor="@color/hilava_text_disabled"
                        android:textSize="13sp"
                        android:paddingVertical="8dp" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
