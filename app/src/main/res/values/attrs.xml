<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Atributos para HilavaAppButton -->
    <declare-styleable name="HilavaAppButton">
        <!-- Cor primária do botão (gradiente) -->
        <attr name="hilava_color" format="color" />
        <!-- Ícone do botão -->
        <attr name="hilava_icon" format="reference" />
        <!-- Texto do label abaixo do botão -->
        <attr name="hilava_label" format="string" />
    </declare-styleable>
</resources>
